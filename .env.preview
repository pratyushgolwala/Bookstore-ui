# ──────────────────────────────────────────────────────────────────────────
# LOCAL PREVIEW MODE — design/QA only. Do NOT use for production builds.
#
# Loaded by Vite when running `npm run dev:preview` (mode = "preview").
# Seeds a mock authenticated user so login-gated pages render without a
# backend. The token is a non-functional placeholder; a real API rejects it.
# ──────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:8000

# Turn on the fake authenticated user
VITE_PREVIEW_AUTH=true

# Which role to preview as: CUSTOMER | AUTHOR | ADMIN
VITE_PREVIEW_ROLE=CUSTOMER
