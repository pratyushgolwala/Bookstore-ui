# ============================================================
# Frontend environment variables (Vite)
# Real values are configured in the Vercel dashboard.
# ============================================================

# Django backend base URL
VITE_API_URL=

# FastAPI analytics microservice base URL
VITE_ANALYTICS_URL=

# FastAPI delivery tracking microservice base URL
VITE_TRACKING_URL=

# FastAPI delivery classification/dispatch microservice base URL
VITE_DELIVERY_URL=

# Google Maps JavaScript API key (browser) — used to render the live
# delivery route map. Restrict it by HTTP referrer in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Razorpay public Key ID (test mode, rzp_test_...).
# Safe to expose — the Key Secret stays on the backend only.
VITE_RAZORPAY_KEY_ID=
